/* Stile di ErmChek: lo stesso di profilemetananni (programma fratello), chiaro e sobrio.
   banco #EEF2F0, carta #FFFFFF, linea #CBD5D1, inchiostro #1C2B27, tenue #52625D,
   agar #1E7A4C (scuro #155C39, chiaro #E3F1E9), ambra #9A5A00/#FFF3DC, rosso #A8251C/#FCE9E7,
   acciaio #2F5D7C/#E6EEF4, grigio #6B7A75/#F1F3F2. Base 18 px. Solo tema chiaro. */

* { font-family: "Atkinson Hyperlegible", "Segoe UI"; font-size: 18px; color: #1C2B27; }
QMainWindow, #area { background: #EEF2F0; }
QScrollArea, QScrollArea > QWidget > QWidget { background: #EEF2F0; border: 0; }
QScrollArea:focus { border: 2px solid #2F5D7C; }
QToolTip { background: #FFFFFF; color: #1C2B27; border: 1px solid #2F5D7C; padding: 6px; font-size: 17px; }

/* avvio: il logo su carta bianca */
#avvio { background: #FFFFFF; }
#avvio QLabel { background: transparent; color: #52625D; }

/* testata */
#testata { background: #FFFFFF; border-bottom: 1px solid #CBD5D1; }
#versione { color: #52625D; font-size: 16px; }
QPushButton#link { background: transparent; border: 2px solid transparent; border-radius: 8px; padding: 6px 10px;
  color: #2F5D7C; }
QPushButton#link:hover, QPushButton#link:focus { background: #E6EEF4; }
QPushButton#link:focus { border-color: #2F5D7C; }

/* percorso a passi */
#percorso { background: #F6F8F7; border-right: 1px solid #CBD5D1; }
#percorso_titolo { color: #52625D; font-weight: bold; font-size: 16px; padding: 0 8px; }
QPushButton#passo { text-align: left; background: transparent; border: 2px solid transparent; border-radius: 8px;
  padding: 10px 8px; color: #52625D; }
QPushButton#passo:hover, QPushButton#passo:focus { background: #E6EEF4; }
QPushButton#passo:focus { border-color: #2F5D7C; }
QPushButton#passo[stato="attivo"] { background: #E3F1E9; color: #1C2B27; font-weight: bold; }
QPushButton#passo[stato="fatto"] { color: #1C2B27; }
#separatore { background: #CBD5D1; max-height: 1px; min-height: 1px; }

/* contenuto */
#titolo { font-size: 32px; font-weight: bold; }
#sottotitolo { font-size: 23px; font-weight: bold; }
#nota { color: #52625D; font-size: 16px; }
#riquadro { border-radius: 12px; border-left: 6px solid #2F5D7C; background: #E6EEF4; }
#riquadro[livello="avviso"] { border-left-color: #9A5A00; background: #FFF3DC; }
#riquadro[livello="errore"] { border-left-color: #A8251C; background: #FCE9E7; }
#riquadro[livello="neutro"] { border-left-color: #6B7A75; background: #F1F3F2; }
#riquadro QLabel { background: transparent; }
#riquadro_titolo { font-weight: bold; }

/* la risposta: un riquadro grande, colore + testo esplicito (mai solo il colore) */
#risposta { border-radius: 14px; border: 2px solid #2F5D7C; background: #E6EEF4; }
#risposta[livello="verde"] { border-color: #1E7A4C; background: #E3F1E9; }
#risposta[livello="ambra"] { border-color: #9A5A00; background: #FFF3DC; }
#risposta[livello="rosso"] { border-color: #A8251C; background: #FCE9E7; }
#risposta QLabel { background: transparent; }
#risposta_grande { font-size: 30px; font-weight: bold; }
#risposta_media { font-size: 22px; }
#risposta_livello { font-weight: bold; font-size: 19px; }

/* barra delle azioni: un solo pulsante principale, in basso a destra */
#azioni { background: #FFFFFF; border-top: 1px solid #CBD5D1; }
#aiuto { color: #52625D; }
#aiuto[livello="avviso"] { color: #9A5A00; font-weight: bold; }
#aiuto[livello="errore"] { color: #A8251C; font-weight: bold; }
QPushButton#principale { background: #1E7A4C; color: #FFFFFF; border: 0; border-radius: 8px;
  padding: 14px 28px; font-weight: bold; font-size: 19px; min-width: 200px; }
QPushButton#principale:hover { background: #155C39; }
QPushButton#principale:focus { background: #155C39; border: 3px solid #1C2B27; text-decoration: underline; }
QPushButton#principale:disabled { background: #DDE5E1; color: #52625D; }
QPushButton#secondario { background: #FFFFFF; border: 1px solid #CBD5D1; border-radius: 8px; padding: 12px 20px; }
QPushButton#secondario:hover { border-color: #2F5D7C; }
QPushButton#secondario:focus { border: 2px solid #2F5D7C; padding: 11px 19px; }
QPushButton#secondario:disabled { background: #EEF2F0; color: #6B7A75; border: 1px dashed #CBD5D1; }
QPushButton#piccolo { background: #FFFFFF; border: 1px solid #CBD5D1; border-radius: 8px; padding: 6px 12px;
  font-size: 16px; }
QPushButton#piccolo:hover { border-color: #2F5D7C; }
QPushButton#piccolo:focus { border: 2px solid #2F5D7C; padding: 5px 11px; }
QPushButton#piccolo:disabled { color: #9DA8A4; border-style: dashed; }

/* schede di scelta e pannelli bianchi */
QFrame#scelta { background: #FFFFFF; border: 1px solid #CBD5D1; border-radius: 12px; }
QFrame#scelta[scelto="true"] { background: #E3F1E9; border: 2px solid #1E7A4C; }
QFrame#scelta[spento="true"] { background: #F1F3F2; border-style: dashed; }
QFrame#scelta[spento="true"] QLabel, QFrame#scelta[spento="true"] QRadioButton { color: #6B7A75; }
QFrame#scelta QLabel, QFrame#scelta QRadioButton, QFrame#scelta QCheckBox { background: transparent; }
QFrame#pannello { background: #FFFFFF; border: 1px solid #CBD5D1; border-radius: 12px; }
QFrame#pannello QLabel, QFrame#pannello QWidget#trasparente { background: transparent; }
#pannello_titolo { font-weight: bold; font-size: 20px; }
#consigliato { color: #1E7A4C; font-weight: bold; font-size: 16px; }
#etichetta_campo { font-weight: bold; }
#nota_campo { color: #52625D; font-size: 15px; }
#errore_campo { color: #A8251C; font-weight: bold; font-size: 16px; }
#conversione { color: #155C39; font-weight: bold; }
#lettera { font-size: 34px; font-weight: bold; color: #2F5D7C; }

/* campi */
QLineEdit, QPlainTextEdit, QComboBox, QDateEdit { background: #FFFFFF; border: 1px solid #CBD5D1; border-radius: 8px;
  padding: 7px 10px; }
QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QDateEdit:focus { border: 2px solid #2F5D7C; }
QLineEdit:disabled, QComboBox:disabled, QDateEdit:disabled { background: #EEF2F0; color: #6B7A75;
  border-style: dashed; }
QLineEdit[errore="true"] { border: 2px solid #A8251C; background: #FCE9E7; }
QComboBox::drop-down, QDateEdit::drop-down { subcontrol-origin: padding; subcontrol-position: center right;
  width: 30px; border: 0; }
QComboBox::down-arrow, QDateEdit::down-arrow { image: url(risorse:freccia_giu.svg); width: 16px; height: 16px; }
QComboBox QAbstractItemView { background: #FFFFFF; selection-background-color: #E3F1E9;
  selection-color: #1C2B27; }
QRadioButton::indicator { width: 16px; height: 16px; border-radius: 10px; border: 2px solid #52625D;
  background: #FFFFFF; }
QRadioButton::indicator:checked { border: 2px solid #1E7A4C; background: qradialgradient(cx:0.5, cy:0.5,
  radius:0.5, fx:0.5, fy:0.5, stop:0 #1E7A4C, stop:0.55 #1E7A4C, stop:0.65 #FFFFFF, stop:1 #FFFFFF); }
QRadioButton::indicator:disabled { border-color: #CBD5D1; }
QRadioButton, QCheckBox { border: 2px solid transparent; border-radius: 6px; padding: 2px 6px; }
QRadioButton:focus, QCheckBox:focus { border-color: #2F5D7C; }
QPlainTextEdit#codice { font-family: "Consolas", "Courier New"; font-size: 16px; background: #F6F8F7; }
QPushButton#apri { background: transparent; border: 0; color: #2F5D7C; text-align: left; padding: 4px 0;
  font-weight: bold; }
QPushButton#apri:hover, QPushButton#apri:focus { text-decoration: underline; }
QProgressBar { background: #E2E8E5; border: 0; border-radius: 6px; height: 12px; max-height: 12px; }
QProgressBar::chunk { background: #1E7A4C; border-radius: 6px; }

/* tabelle compatte dei risultati */
QTableWidget { background: #FFFFFF; border: 1px solid #CBD5D1; border-radius: 8px; gridline-color: #E2E8E5;
  font-size: 17px; }
QTableWidget::item { padding: 4px 8px; }
QHeaderView::section { background: #F6F8F7; border: 0; border-bottom: 1px solid #CBD5D1; padding: 6px 8px;
  font-weight: bold; font-size: 16px; }
